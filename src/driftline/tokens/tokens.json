      "lg": 20,
      "xl": 28,
      "pill": 999
    },
    "type": {
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 500,
        "track": 0.01
      },
      "footnote": {
        "size": 13,
        "line": 18,
        "weight": 500,
        "track": 0
      },
      "callout": {
        "size": 15,
        "line": 20,
        "weight": 500,
        "track": 0
      },
