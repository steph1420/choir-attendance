        "size": 16,
        "line": 22,
        "weight": 400,
        "track": 0
      },
      "headline": {
        "size": 17,
        "line": 22,
        "weight": 600,
        "track": -0.01
      },
      "title3": {
        "size": 20,
        "line": 26,
        "weight": 600,
        "track": -0.01
      },
      "title2": {
        "size": 24,
        "line": 30,
        "weight": 700,
        "track": -0.015
      },
      "title1": {
        "size": 30,
        "line": 36,
        "weight": 700,
        "track": -0.02
      },
      "display": {
        "size": 44,
        "line": 48,
        "weight": 700,
        "track": -0.03
      }
    },
    "font": {
      "sans": "\"SF Pro Text\", \"SF Pro Display\", -apple-system, BlinkMacSystemFont, \"Inter\", system-ui, \"Segoe UI\", Roboto, sans-serif",
      "mono": "\"SF Mono\", ui-monospace, \"JetBrains Mono\", Menlo, monospace"
    },
    "hit": {
      "min": 44,
      "comfortable": 48,
      "stage": 56,
      "gap": 8
    },
    "density": {
      "comfortable": {
        "row": 56,
        "control": 44,
        "pad": 16,
        "gap": 12
      },
      "compact": {
        "row": 48,
        "control": 44,
        "pad": 12,
        "gap": 8
      },
      "stage": {
        "row": 64,
        "control": 56,
        "pad": 20,
        "gap": 12
      }
    },
    "blur": {
      "chrome": 24,
      "card": 16,
      "none": 0
    },
    "z": {
      "content": 0,
      "sticky": 30,
      "header": 40,
      "dock": 40,
      "island": 50,
      "scrim": 60,
      "sheet": 70,
      "toast": 80
    }
  },
  "motion": {
    "spring": {
      "snappy": {
        "stiffness": 450,
        "damping": 32,
        "mass": 0.8,
        "use": "selection pills, toggles, badges"
      },
      "smooth": {
        "stiffness": 260,
        "damping": 28,
        "mass": 1.2,
        "use": "sheets, header FULL/PILL, panels"
      },
      "gentle": {
        "stiffness": 180,
        "damping": 24,
        "mass": 1,
        "use": "cards entering, toasts"
      },
      "island": {
        "duration": 0.55,
        "bounce": 0.12,
        "use": "capsule morphs (Pill <-> expanded)"
      }
    },
    "duration": {
      "instant": 120,
      "quick": 200,
      "calm": 320,
      "deliberate": 550
    },
    "ease": {
      "settle": "cubic-bezier(0.2, 0.9, 0.3, 1)",
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "press": {
      "scale": 0.96,
      "durationMs": 90
    },
    "attention": {
      "beats": 1,
      "maxBeats": 3,
      "durationMs": 900
    },
    "header": {
      "enterPillAfter": 72,
      "activateDelta": 6,
      "ignoreJump": 14,
      "topZone": 28,
      "lockMs": 260,
      "resizeFreezeMs": 380
    },
    "hold": {
      "durationMs": 600,
      "note": "hold-to-confirm time (LOCKED standard t208u; duration PROPOSED)"
    }
  },
  "haptic": {
    "selection": {
      "pattern": [
        8
      ],
      "use": "moving a selection: pill, tab, segment"
    },
    "tap": {
      "pattern": [
        14
      ],
      "use": "pressing a button or toggle"
    },
    "confirm": {
      "pattern": [
        12,
        40,
        18
      ],
      "use": "a meaningful action completed (saved, marked, sent)"
    },
    "warning": {
      "pattern": [
        24,
        60,
        24
      ],
      "use": "needs attention, reversible"
    },
    "error": {
      "pattern": [
        40,
        50,
        40,
        50,
        40
      ],
      "use": "failed or blocked"
    },
    "hold": {
      "pattern": [
        40,
        50
      ],
      "use": "long-press menu opened"
    }
  },
  "component": {
    "header": {
      "bg": "surface-solid",
      "height": 112,
      "pill-bg": "surface-chrome",
      "pill-height": 44
    },
    "dock": {
      "bg": "surface-chrome",
      "active-from": "accent-fill",
      "active-to": "accent-fill-2",
      "active-text": "on-accent",
      "height": 60
    },
    "segment": {
      "track": "track",
      "active-from": "accent-fill",
      "active-to": "accent-fill-2",
      "active-text": "on-accent",
      "text": "text-muted"
    },
    "card": {
      "bg": "surface",
      "border": "hairline",
      "radius": "lg"
    },
    "sheet": {
      "bg": "surface-raised",
      "radius": "xl",
      "scrim": "scrim"
    },
    "toast": {
      "bg": "surface-raised",
      "radius": "pill"
    },
    "button": {
      "primary-from": "accent-fill",
      "primary-to": "accent-fill-2",
      "primary-text": "on-accent",
      "radius": "md"
    },
    "toggle": {
      "off": "track",
      "on": "positive",
      "knob": "#ffffff"
    },
    "chip": {
      "mix-dark": 16,
      "mix-light": 12,
      "border-mix": 42
    }
  },
